# Reglas de cache inmutable para assets pesados y versionados
/bocho_optimized.glb
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/draco/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Reglas para el HTML principal (siempre fresco para detectar nuevos despliegues)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=*, gyroscope=*, magnetometer=*, xr-spatial-tracking=*

/index.html
  Cache-Control: public, max-age=0, must-revalidate
